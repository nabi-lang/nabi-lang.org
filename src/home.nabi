// The nabi-lang.org landing page.

use pkg::Site;
use pkg::layout;
use pkg::layout::tr;
use core::encoding;
use markdown::esc;
use std::fs;
use web::lang::Lang;

/// A program from the docs' examples.
pub struct Example {
    pub title: str;
    pub lead: str;
    pub href: str;
}

/// The changelog section of one release.
struct News {
    date: str;
    items: List<str>;
}

/// Shown first, in this order, when the docs have them.
const PICKS: [str; 8] = ["sudoku", "game-of-life", "interpreter", "tcp-echo", "text-adventure", "csv-report", "word-count", "json-parser"];

/// The `## <release> (<date>)` section of CHANGELOG.md, one entry per
/// top-level bullet.
fn news(path: str, release: str) -> News | none {
    let text = try fs::read_to_str(path) catch _ { return none; };
    let head = f"## {release} (";
    let date = "";
    let items: List<str> = List::new();
    let on = false;
    for l in text.lines() {
        if l.starts_with("## ") {
            if on { break; }
            if l.starts_with(head) {
                on = true;
                date = l[head.len():].trim_end_matches(")");
            }
            continue;
        }
        if !on { continue; }
        if l.starts_with("- ") {
            items.push(l[2:]);
        } else if l.starts_with("  ") && items.len() > 0 {
            items[items.len() - 1] = items[items.len() - 1] + " " + l.trim();
        }
    }
    if !on { return none; }
    News { date: date, items: items }
}

/// `#123` in a changelog entry as a link to that issue or pull request
/// (GitHub sends either address to the right one).
pub fn refs(html: str) -> str {
    let out = StrBuf::new();
    let rest = html;
    loop {
        let k = rest.find("#") ?? rest.len();
        out.push_str(rest[:k]);
        if k == rest.len() { break; }
        let n = 0usize;
        for c in rest[k + 1:].chars() {
            if c < '0' || c > '9' { break; }
            n += 1;
        }
        let before = if k == 0 { ' ' } else { (out.to_str().chars().last() ?? ' ') };
        if n == 0 || !(before == ' ' || before == '(' || before == ',') {
            out.push('#');
            rest = rest[k + 1:];
            continue;
        }
        let num = rest[k + 1:k + 1 + n];
        out.push_str(f"<a href=\"https://github.com/nabi-lang/nabi/issues/{num}\">#{num}</a>");
        rest = rest[k + 1 + n:];
    }
    out.to_str()
}

/// Inline markdown, without the paragraph.
fn inline(s: str) -> str {
    let h = layout::md(s, |x| x, Lang::En).html.trim();
    if h.starts_with("<p>") && h.ends_with("</p>") { h[3:h.len() - 4] } else { h }
}

fn code(src: str) -> str { f"<pre class=\"cb pre\"><code>{nabi_syntax::highlight_nabi(src)}</code></pre>" }

/// A program of the landing page (home/<name>/) and what `nabi run` prints
/// for it (home/<name>.out), both checked in; `nabi run -- check` reruns
/// them with the toolchain and fails when the output has changed.
pub struct Sample {
    pub name: str;
    pub src: str;
    pub out: str;
}

pub const SAMPLES: [Sample; 3] = [
    Sample { name: "describe", src: include_str!("../home/describe/src/main.nabi"), out: include_str!("../home/describe.out") },
    Sample { name: "find", src: include_str!("../home/find/src/main.nabi"), out: include_str!("../home/find.out") },
    Sample { name: "ages", src: include_str!("../home/ages/src/main.nabi"), out: include_str!("../home/ages.out") },
];

fn sample(name: str) -> Sample {
    for s in SAMPLES {
        if s.name == name { return s; }
    }
    SAMPLES[0]
}

/// The line `nabi run` points at (`--> src/main.nabi:3:13`), or 0.
fn error_line(out: str) -> usize {
    for l in out.lines() {
        if let r: str = l.trim().strip_prefix("--> src/main.nabi:") {
            return try (r.split_once(":") ?? (r, "")).0.parse::<usize>() catch _ { 0usize };
        }
    }
    0
}

/// `src` highlighted, one `.ln` per line, line `hl` marked.
fn numbered(src: str, hl: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for l in src.trim_end().split("\n") {
        k += 1;
        let cls = if k == hl { "ln hl" } else { "ln" };
        out.push_str(f"<span class=\"{cls}\">{nabi_syntax::highlight_nabi(l)}\n</span>");
    }
    // No line break after the last line: it would show as an empty line.
    out.to_str().replace("\n</span>", "</span>").replace("</span><span class=\"ln", "\n</span><span class=\"ln")
}

/// What nabic printed as a terminal transcript in its own colours, after
/// `$ nabi run`; each error code links to its page (`docs`).
fn transcript(out: str, docs: fn(str) -> str) -> str {
    let body = pkg::links::link_codes_in(layout::diag_html(out), |c| docs(f"errors/{c}.html"));
    "<span class=\"p\">$</span> nabi run\n" + body
}

/// The playground with `src` in its editor (its pages in `l`): `#src=`
/// and the source as base64url, which every browser opens; search.js
/// swaps in the shorter deflated `#code=` where it can.
fn play_link(site: Site, src: str, l: Lang) -> str { site.playground + "/" + l.slug() + "#src=" + encoding::base64::encode(src, encoding::base64::URL_SAFE_NO_PAD) }

/// A program and what nabic says about it: the code with the reported
/// line marked, then the terminal, a figure whose caption (for screen
/// readers) says what it shows; aria-label on a <pre> is not read.
fn program(site: Site, s: Sample, docs: fn(str) -> str, label: str, l: Lang) -> str {
    let hl = error_line(s.out);
    let play = f"<a class=\"btn-2 btn-sm play\" href=\"{esc(play_link(site, s.src, l))}\" aria-label=\"{tr(l, "Run src/main.nabi in the playground", "플레이그라운드에서 src/main.nabi 실행", "在 Playground 中运行 src/main.nabi", "在 Playground 中執行 src/main.nabi")}\">{tr(l, "Run", "실행", "运行", "執行")} ↗</a>";
    f"<div class=\"cb prog\"><div class=\"cb-h\"><span class=\"t-label\">src/main.nabi</span>{play}</div><pre class=\"pre\"><code>{numbered(s.src, hl)}</code></pre></div>
<figure class=\"term-fig\"><div class=\"term-bar\" aria-hidden=\"true\">~/{s.name}</div><pre class=\"term\">{transcript(s.out, docs)}</pre><figcaption class=\"sr-only\">{label}</figcaption></figure>"
}

fn feature(site: Site, title: str, text: str, link: str, label: str, s: Sample, docs: fn(str) -> str, l: Lang) -> str {
    f"<div class=\"feat\"><div class=\"feat-t\"><h3 class=\"t-h3\">{title}</h3><p>{text}</p><a class=\"t-ui\" href=\"{esc(link)}\">{label}</a></div><div class=\"feat-f\">{program(site, s, docs, tr(l, "nabi run in a terminal: what nabic reports for this program", "터미널의 nabi run: 이 프로그램에 대해 nabic이 알려 주는 내용", "终端里的 nabi run：nabic 对这个程序的报告", "終端機裡的 nabi run：nabic 對這個程式的回報"), l)}</div></div>\n"
}

/// The install commands: the shell script, the PowerShell one.
const SH: str = "curl -fsSL https://nabi.sh | sh";
const PS: str = "powershell -ExecutionPolicy Bypass -c \"irm https://nabi.sh/install.ps1 | iex\"";

