// The docs around one version's build: released versions re-wrapped from
// their archived bundles, latest/, and the files above the version
// directories (versions.json, the redirect to latest/, robots.txt, the
// sitemap and the 404 page).

use pkg::files::write_version;
use pkg::layout;
use pkg::links::{check, site_hrefs};
use pkg::llms;
use pkg::www::sitemap;
use pkg::{Bundle, Site, Versions, wrap};
use std::fs;
use std::nabion;
use web::build::{json_str, write};

/// What latest/ is written from: the newest release's pages, search
/// indexes and llms files.
pub struct Latest {
    pub pages: Dict<str, str>;
    pub search: str;
    pub search_ko: str;
    pub text: (str, str);
    pub llms: (str, str);
}

/// Release `v`'s bundle in the archive `archive`.
pub fn bundle(archive: str, v: str) throws -> Bundle {
    let path = f"{archive}/{v}/bundle.nabion";
    try nabion::from_str(try fs::read_to_str(path)) catch e { throw ValueError::new(f"{path}: {e}"); }
}

/// The released versions other than the one built now that `archive`
/// holds, each re-wrapped with the current chrome into `docs_root`, so a
/// design change reaches them while their content stays pinned. `serve`
/// archives each release once and points NABI_DOCS_ARCHIVE at the
/// archive. `latest` as the newest's when it is one of them, and the
/// broken links found. `site.no_errors` is left as the last version had
/// it, for the pages above the versions.
pub fn rewrap(ref site: Site, vs: Versions, archive: str, docs_root: str, latest_outs: Set<str>, latest: Latest) throws -> (Latest, List<str>) {
    let version = site.version;
    let bad: List<str> = List::new();
    let out = latest;
    for v in vs.released {
        if v == version { continue; }
        if !fs::exists(f"{archive}/{v}/bundle.nabion") { continue; }
        let b = try bundle(archive, v);
        site.version = v;
        site.no_errors = true;
        for f in b.pages {
            if f.out == "errors/index.html" { site.no_errors = false; }
        }
        let vfiles: Dict<str, str> = Dict::new();
        for f in b.pages { vfiles.insert(f.out, wrap(site, f, latest_outs)); }
        let vstatics = try write_version(site, docs_root, v, vfiles, b.search, b.search_ko, (b.text, b.text_ko), (b.llms, b.llms_full));
        try write(docs_root + "/" + v, "og.nabion", try nabion::to_str(layout::cards(b.pages)));
        for bd in check(vfiles, vstatics) { bad.push(f"[{v}] {bd}"); }
        if v == site.newest { out = Latest { pages: vfiles, search: b.search, search_ko: b.search_ko, text: (b.text, b.text_ko), llms: (b.llms, b.llms_full) }; }
        println(f"docs {v}: {b.pages.len()} pages re-wrapped from archive → {docs_root}/{v}/");
    }
    site.version = version;
    (out, bad)
}

/// The files above the version directories: the version list for the
/// menu, a redirect to latest/, robots.txt, the sitemap of latest/
/// (`latest_outs` but `latest_hidden`) and the 404 page (which borrows
/// latest/'s files); and latest/ itself from `latest`, whose llms files
/// both hosts answer /llms.txt with. Whether latest/ was written.
pub fn root(ref site: Site, vs: Versions, docs_root: str, www_dir: str, latest_outs: Set<str>, latest_hidden: Set<str>, latest: Latest) throws -> bool {
    let version = site.version;
    let newest = site.newest;
    let list = StrBuf::new();
    let patches = StrBuf::new();
    for v in vs.released {
        if !list.is_empty() { list.push(','); }
        list.push_str(json_str(v));
        if vs.patches.contains_key(v) {
            if !patches.is_empty() { patches.push(','); }
            patches.push_str(f"{json_str(v)}:{json_str(vs.patches[v])}");
        }
    }
    try write(docs_root, "versions.json", f"{{\"latest\":{json_str(newest)},\"released\":[{list.to_str()}],\"patches\":{{{patches.to_str()}}}}}\n");
    try write(docs_root, "index.html", layout::to_latest(site));
    try write(docs_root, "robots.txt", f"User-agent: *\nDisallow: /dev/\nSitemap: {site.docs_url}/sitemap.xml\n");
    // The sitemap lists latest/: this build's pages if it is the newest
    // release, else the archived ones.
    if latest_outs.len() > 0 {
        let urls: List<str> = List::new();
        for out in latest_outs {
            if out != "404.html" && !latest_hidden.contains(out) { urls.push(layout::latest(site, if out == "index.html" { "" } else { out })); }
        }
        urls.sort();
        try write(docs_root, "sitemap.xml", sitemap(urls));
    }
    // latest/ follows the newest release, whether built now or re-wrapped
    // from the archive; its own 404 page speaks for it and, above the
    // version directories, for the docs root.
    site.version = if newest.is_empty() { version } else { newest };
    let has = !newest.is_empty() && latest.pages.len() > 0;
    if has {
        _ = try write_version(site, docs_root, "latest", latest.pages, latest.search, latest.search_ko, latest.text, latest.llms);
        if !latest.llms.0.is_empty() {
            let base = site.docs_url + "/latest";
            for dir in [docs_root, www_dir] {
                try write(dir, "llms.txt", latest.llms.0.replace(llms::BASE, base));
                try write(dir, "llms-full.txt", latest.llms.1.replace(llms::BASE, base));
            }
        }
    }
    try write(docs_root, "404.html", site_hrefs(site, layout::not_found_page(site, "latest", false), "/latest", "404.html"));
    site.version = version;
    has
}
