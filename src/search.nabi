// The search index of one language: pages, their sections and the
// API's items, with excerpts.

use pkg::Page;
use pkg::layout;
use web::build::{between, json_str};
use web::lang;
use web::url;

/// The first paragraph after each `##` / `###` heading of `html`, as
/// plain text cut to a search excerpt, by heading id.
fn section_leads(html: str) -> Dict<str, str> {
    let out: Dict<str, str> = Dict::new();
    let at = 0usize;
    loop {
        let k = html[at:].find(" id=\"") ?? break;
        let i = at + k;
        at = i + 5;
        if i < 3 || !(html[i - 3:i] == "<h2" || html[i - 3:i] == "<h3") { continue; }
        let id = html[at:at + (html[at:].find("\"") ?? 0)];
        let close = (html[at:].find("</h") ?? continue) + at;
        let next_h = (html[close + 3:].find("<h") ?? html.len()) + close + 3;
        if let (para, _): (str, usize) = between(html, close, "<p>", "</p>") {
            let pos = (html[close:].find("<p>") ?? 0) + close;
            if pos < next_h { out.insert(id, clip_text(markdown::strip_tags(para).replace("\n", " ").trim(), 110)); }
        }
    }
    out
}

fn clip_text(s: str, n: usize) -> str {
    if s.char_count() <= n { return s; }
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n { break; }
        out.push(c);
        k += 1;
    }
    out.to_str().trim_end() + "…"
}

/// The search index of one language: {"p": [[title, url, excerpt]], "h":
/// [[page, text, id, named, kind, excerpt]]}. A url is the page's
/// canonical address in its version (`learn/05-sum-types`); `named` is 1
/// when many pages share the heading (`Code`), so results name its page;
/// `kind` is the API item's (`fn`, `method`, `struct` ..) or `""`.
pub fn index(groups: [List<Page>; 3]) -> str {
    let seen: Dict<str, usize> = Dict::new();
    for group in groups {
        for p in group {
            for h in p.heads { seen.insert(h.text, (seen.get(h.text) ?? 0usize) + 1); }
        }
    }
    let pl = StrBuf::new();
    let hl = StrBuf::new();
    let n = 0usize;
    for group in groups {
        for p in group {
            // A docs home is the version's start, not a hit; a package's
            // root module (src "pkg") is.
            if lang::split(p.out).1 == "index.html" && p.src != "pkg" { continue; }
            if n > 0 { pl.push_str(",\n"); }
            let lead = clip_text(layout::lead_text(p.html), 110);
            pl.push_str(f"[{json_str(p.title)},{json_str(url::canon(p.out))},{json_str(lead)}]");
            let leads: Dict<str, str> = if p.html.is_empty() { Dict::new() } else { section_leads(p.html) };
            for h in p.heads {
                if h.level != 2 && h.level != 3 { continue; }
                let (kind, note) = (p.notes.get(h.id) ?? "\t").split_once("\t") ?? ("", "");
                let text = if kind.is_empty() { h.text } else { api_name(h.text, kind) };
                let named = if kind.is_empty() && (seen.get(h.text) ?? 0usize) >= 4 { 1 } else { 0 };
                let ex = if kind.is_empty() { leads.get(h.id) ?? "" } else { note };
                if !hl.is_empty() { hl.push_str(",\n"); }
                hl.push_str(f"[{n},{json_str(text)},{json_str(h.id)},{named},{json_str(kind)},{json_str(ex)}]");
            }
            n += 1;
        }
    }
    f"{{\"p\":[\n{pl.to_str()}],\n\"h\":[\n{hl.to_str()}]}}\n"
}

/// An API heading's search name: `core::collections::list::List::push`
/// -> `List::push` for a member, `List` for an item.
fn api_name(text: str, kind: str) -> str {
    let parts: List<str> = List::new();
    for x in text.split("::") { parts.push(x); }
    if parts.len() >= 2 && (kind == "method" || kind == "field" || kind == "variant" || kind == "assoc") { return parts[parts.len() - 2] + "::" + parts[parts.len() - 1]; }
    if text.starts_with("impl ") { return text; }
    parts[parts.len() - 1]
}

/// Words a body search gains nothing from.
fn stop_words() -> Set<str> {
    let s: Set<str> = Set::new();
    for w in ["the", "and", "for", "are", "but", "not", "you", "your", "with", "this", "that", "from", "into", "its", "has", "have", "was", "were", "can", "will", "than", "then", "them", "they", "their", "there", "these", "those", "which", "what", "when", "also", "only", "each", "any", "all", "one", "two", "more", "same", "other", "does", "doesn", "isn", "here", "such", "some", "most", "out", "how", "who", "why", "amp", "quot", "nbsp", "the", "an", "as", "at", "be", "by", "do", "if", "in", "is", "it", "of", "on", "or", "so", "to", "we", "no", "이", "그", "수", "것", "등", "및", "더"] { s.insert(w); }
    s
}

/// A Korean word of three syllables or more without its particle
/// ("타입을" -> "타입"), as search.tsx strips a query.
fn bare(w: str) -> str {
    let n = w.char_count();
    if n < 3 { return w; }
    for c in w.chars() {
        if c < '가' || c > '힣' { return w; }
    }
    for p in ["으로", "에서", "에게", "까지", "부터", "이나", "은", "는", "이", "가", "을", "를", "의", "에", "로", "와", "과", "도", "만"] {
        if w.ends_with(p) && w.char_count() > p.char_count() + 1 { return w[:w.len() - p.len()]; }
    }
    w
}

/// A Han character: the CJK ideographs, extension A and the
/// compatibility ones (search.tsx's HAN).
pub fn is_han(c: char) -> bool {
    (c >= '\u{3400}' && c <= '\u{4DBF}') || (c >= '\u{4E00}' && c <= '\u{9FFF}') || (c >= '\u{F900}' && c <= '\u{FAFF}')
}

/// A run of Han text as the index holds it, Chinese having no spaces:
/// every two characters side by side, and the last character alone, so
/// that a query of one character (a prefix) finds each place it is.
fn han_words(run: str, into: Set<str>) {
    let cs: List<char> = List::new();
    for c in run.chars() { cs.push(c); }
    for k in 0..cs.len() {
        let b = StrBuf::new();
        b.push(cs[k]);
        if k + 1 < cs.len() { b.push(cs[k + 1]); }
        into.insert(b.to_str());
    }
}

/// The words of plain text `s`: letters, digits and `_`, lowercased;
/// Hangul words bare of their particle; Han runs as han_words; one or two
/// Latin letters, bare numbers and stop words left out.
fn words(s: str, stop: Set<str>, into: Set<str>) {
    let w = StrBuf::new();
    let han = StrBuf::new();
    for c in (s + " ").chars() {
        if is_han(c) {
            han.push(c);
        } else if !han.is_empty() {
            han_words(han.to_str(), into);
            han = StrBuf::new();
        }
        if !is_han(c) && (c.is_alphanumeric() || c == '_') {
            w.push(c);
            continue;
        }
        if w.is_empty() { continue; }
        let t = bare(w.to_str().to_lowercase());
        w = StrBuf::new();
        let hangul = t.chars().any(|c: char| c >= '가' && c <= '힣');
        if (!hangul && t.len() < 3) || t.char_count() > 40 || stop.contains(t) { continue; }
        if t.chars().all(|c: char| (c >= '0' && c <= '9') || c == '_') { continue; }
        into.insert(t);
    }
}

/// `n` in base 36.
fn b36(n: usize) -> str {
    if n == 0 { return "0"; }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
    let out: List<str> = List::new();
    let v = n;
    while v > 0 {
        out.push(digits[v % 36:v % 36 + 1]);
        v /= 36;
    }
    out.reverse();
    out.join("")
}

/// Plain text of the parts of `html` a search hit can point at: before
/// the first `##` / `###` heading (the page), then one per heading by id.
fn sections(html: str) -> (str, Dict<str, str>) {
    let out: Dict<str, str> = Dict::new();
    let first = "";
    let at = 0usize;
    let cur = "";
    let from = 0usize;
    loop {
        let k = html[at:].find(" id=\"") ?? break;
        let i = at + k;
        at = i + 5;
        if i < 3 || !(html[i - 3:i] == "<h2" || html[i - 3:i] == "<h3") { continue; }
        let text = markdown::strip_tags(html[from:i - 3]);
        if cur.is_empty() { first = text; } else { out.insert(cur, (out.get(cur) ?? "") + " " + text); }
        cur = html[at:at + (html[at:].find("\"") ?? 0)];
        from = i - 3;
    }
    let text = markdown::strip_tags(html[from:]);
    if cur.is_empty() { first = text; } else { out.insert(cur, (out.get(cur) ?? "") + " " + text); }
    (first, out)
}

/// The body-text index beside `index` (same `groups`, same order): {"n":
/// entries, "w": [[word, ids]]}, words sorted, each word's entries as
/// rising base-36 gaps joined by `,`. An entry is a page (its text before
/// the first section) or a `##` / `###` section, numbered as search.tsx
/// numbers them: the pages first, then the sections in index order.
/// Words in more than a fifth of the entries say nothing and are left
/// out. Only the first `with_text` groups give their text; the rest (the
/// API) give each item's summary, the words of its excerpt.
pub fn text_index(groups: [List<Page>; 3], with_text: usize) -> str {
    let stop = stop_words();
    // (is a section, its number among pages or sections, its words)
    let ents: List<(bool, usize, Set<str>)> = List::new();
    let np = 0usize;
    let nh = 0usize;
    let gi = 0usize;
    for group in groups {
        gi += 1;
        for p in group {
            if lang::split(p.out).1 == "index.html" { continue; }
            if gi > with_text {
                // An API item gives the words of its summary, so a query
                // finds what it does as well as its name.
                for h in p.heads {
                    if h.level != 2 && h.level != 3 { continue; }
                    let (_, note) = (p.notes.get(h.id) ?? "\t").split_once("\t") ?? ("", "");
                    if !note.is_empty() {
                        let hw: Set<str> = Set::new();
                        words(note, stop, hw);
                        ents.push((true, nh, hw));
                    }
                    nh += 1;
                }
                np += 1;
                continue;
            }
            let (lead, secs) = sections(p.html);
            let pw: Set<str> = Set::new();
            words(p.title + " " + lead, stop, pw);
            ents.push((false, np, pw));
            for h in p.heads {
                if h.level != 2 && h.level != 3 { continue; }
                let hw: Set<str> = Set::new();
                words(secs.get(h.id) ?? h.text, stop, hw);
                ents.push((true, nh, hw));
                nh += 1;
            }
            np += 1;
        }
    }
    let post: Dict<str, List<usize>> = Dict::new();
    for (sec, k, ws) in ents {
        let id = if sec { np + k } else { k };
        for w in ws {
            if !post.contains_key(w) { post.insert(w, List::new()); }
            post[w].push(id);
        }
    }
    let total = np + nh;
    let keys: List<str> = List::new();
    // A Han pair stays however common: a query is cut into pairs, each of
    // which has to be found.
    for w in post.keys() {
        if post[w].len() * 5 <= total || is_han(w.chars().next() ?? ' ') { keys.push(w); }
    }
    keys.sort();
    let b = StrBuf::new();
    b.push_str(f"{{\"n\":{total},\"w\":[\n");
    let first = true;
    for w in keys {
        let ids = post[w];
        ids.sort();
        let gaps: List<str> = List::new();
        let last = 0usize;
        for id in ids {
            gaps.push(b36(id - last));
            last = id;
        }
        if !first { b.push_str(",\n"); }
        first = false;
        b.push_str(f"[{json_str(w)},\"{gaps.join(",")}\"]");
    }
    b.push_str("]}\n");
    b.to_str()
}

/// The elements of the JSON array `line` starts with, each as written
/// (a string with its quotes), or none when it starts with none. The
/// indexes nest no arrays in an entry and write one entry per line.
pub fn fields(line: str) -> List<str> | none {
    if !line.starts_with("[") { return none; }
    let out: List<str> = List::new();
    let n = line.len();
    let i = 1usize;
    let start = 1usize;
    let quoted = false;
    while i < n {
        let b = line.byte(i);
        if quoted {
            // a backslash escapes the next byte
            if b == 92u8 { i += 2; continue; }
            if b == 34u8 { quoted = false; }
        } else if b == 34u8 {
            quoted = true;
        } else if b == 44u8 {
            out.push(line[start:i]);
            start = i + 1;
        } else if b == 93u8 {
            if i > start { out.push(line[start:i]); }
            return out;
        }
        i += 1;
    }
    none
}

/// Entries per excerpt file (Split::excerpts).
pub const CHUNK: usize = 256;

/// The text index's files, by the first letter of their words: `a`..`z`,
/// `0` (digits and `_`), `k0`..`k18` (Hangul, by initial consonant),
/// `h0`..`h15` (Han, by code point: 16 equal ranges of the unified
/// ideographs, the rest of Han in `h15`) and `other`. search.tsx works
/// out the same name for a query word.
pub fn shards() -> List<str> {
    let out: List<str> = List::new();
    for c in "abcdefghijklmnopqrstuvwxyz".chars() {
        let b = StrBuf::new();
        b.push(c);
        out.push(b.to_str());
    }
    out.push("0");
    for k in 0..19 { out.push(f"k{k}"); }
    for k in 0..HAN_SHARDS { out.push(f"h{k}"); }
    out.push("other");
    out
}

const HAN_SHARDS: usize = 16;
/// 0x4E00..0x9FFF in HAN_SHARDS ranges.
const HAN_SPAN: u32 = 0x520u32;

/// The text index file of word `w` (shards).
pub fn shard_of(w: str) -> str {
    for c in w.chars() {
        if c >= 'a' && c <= 'z' {
            let b = StrBuf::new();
            b.push(c);
            return b.to_str();
        }
        if (c >= '0' && c <= '9') || c == '_' { return "0"; }
        if c >= '가' && c <= '힣' { return f"k{((c as u32) - 0xAC00u32) / 588u32}"; }
        if c >= '\u{4E00}' && c <= '\u{9FFF}' { return f"h{((c as u32) - 0x4E00u32) / HAN_SPAN}"; }
        if is_han(c) { return f"h{HAN_SHARDS - 1}"; }
        return "other";
    }
    "other"
}

/// What a version directory serves for search, made from an index and a
/// text index as `index` and `text_index` write them (archived ones
/// too): `names`, search-index.json without the excerpts (titles,
/// addresses, heading ids, kinds), read on the first search; the
/// excerpts, CHUNK entries a file (search-x/<k>.json, a JSON list in
/// entry order), read for the hits shown; and the text index split by
/// shard_of (search-text/<shard>.json), read for a query's words. An
/// empty `text` gives no text files.
pub struct Split {
    pub names: str;
    pub excerpts: List<str>;
    pub text: Dict<str, str>;
}

pub fn split(index: str, text: str) -> Split {
    let pl = StrBuf::new();
    let hl = StrBuf::new();
    let px: List<str> = List::new();
    let hx: List<str> = List::new();
    let in_h = false;
    for line in index.lines() {
        if line.starts_with("\"h\":") { in_h = true; continue; }
        let f = fields(line) ?? continue;
        if f.len() < 2 || (in_h && f.len() < 3) { continue; }
        if in_h {
            // [page, heading, id, named, kind, excerpt]
            if !hl.is_empty() { hl.push_str(",\n"); }
            let named = if f.len() > 3 { f[3] } else { "0" };
            let kind = if f.len() > 4 { f[4] } else { "\"\"" };
            hl.push_str(f"[{f[0]},{f[1]},{f[2]},{named},{kind}]");
            hx.push(if f.len() > 5 { f[5] } else { "\"\"" });
        } else {
            // [title, url, excerpt]
            if !pl.is_empty() { pl.push_str(",\n"); }
            pl.push_str(f"[{f[0]},{f[1]}]");
            px.push(if f.len() > 2 { f[2] } else { "\"\"" });
        }
    }
    px.extend(hx);
    let excerpts: List<str> = List::new();
    let at = 0usize;
    while at < px.len() {
        let end = if at + CHUNK < px.len() { at + CHUNK } else { px.len() };
        let part: List<str> = List::new();
        for k in at..end { part.push(px[k]); }
        excerpts.push("[" + part.join(",\n") + "]\n");
        at = end;
    }
    let out = Split { names: f"{{\"p\":[\n{pl.to_str()}],\n\"h\":[\n{hl.to_str()}]}}\n", excerpts: excerpts, text: Dict::new() };
    if text.is_empty() { return out; }
    let head = if let (n, _): (str, usize) = between(text, 0, "{\"n\":", ",") { n } else { "0" };
    let by: Dict<str, StrBuf> = Dict::new();
    for k in shards() { by.insert(k, StrBuf::new()); }
    for line in text.lines() {
        let f = fields(line) ?? continue;
        if f.len() < 2 || f[0].len() < 3 { continue; }
        let b = by[shard_of(f[0][1:])];
        if !b.is_empty() { b.push_str(",\n"); }
        b.push_str(f"[{f[0]},{f[1]}]");
    }
    for k in by.keys() { out.text.insert(k, f"{{\"n\":{head},\"w\":[\n{by[k].to_str()}]}}\n"); }
    out
}

/// One names index (Split::names) of `parts`, each `(prefix, index)`:
/// every page's url gains its prefix (`json/latest/`; the root page's
/// `""` becomes `json/latest`) and each heading points at its page anew.
pub fn merge(parts: List<(str, str)>) -> str {
    let pl = StrBuf::new();
    let hl = StrBuf::new();
    let base = 0usize;
    for (prefix, index) in parts {
        let n = 0usize;
        let in_h = false;
        for line in split(index, "").names.lines() {
            if line.starts_with("\"h\":") { in_h = true; continue; }
            let f = fields(line) ?? continue;
            if in_h {
                if f.len() < 5 { continue; }
                let k = try f[0].parse::<usize>() catch _ { continue; };
                if !hl.is_empty() { hl.push_str(",\n"); }
                hl.push_str(f"[{base + k},{f[1]},{f[2]},{f[3]},{f[4]}]");
            } else {
                if f.len() < 2 { continue; }
                let u = if f[1] == "\"\"" { json_str(prefix.trim_end_matches("/")) } else { "\"" + prefix + f[1][1:] };
                if !pl.is_empty() { pl.push_str(",\n"); }
                pl.push_str(f"[{f[0]},{u}]");
                n += 1;
            }
        }
        base += n;
    }
    f"{{\"p\":[\n{pl.to_str()}],\n\"h\":[\n{hl.to_str()}]}}\n"
}

#[test]
fn split_and_merge() {
    let idx = "{\"p\":[\n[\"A, \\\"b\\\"\",\"learn/a\",\"lead, a\"],\n[\"B\",\"b\",\"\"]],\n\"h\":[\n[0,\"Sec\",\"sec\",0,\"\",\"x]y\"],\n[1,\"push\",\"List.push\",0,\"method\",\"Add\"]]}\n";
    let f = fields("[0,\"a,\\\"]\",\"b\"]],") ?? panic("fields");
    assert(f.len() == 3 && f[1] == "\"a,\\\"]\"" && f[2] == "\"b\"", f.join("|"));
    let s = split(idx, "{\"n\":4,\"w\":[\n[\"apple\",\"1\"],\n[\"타입\",\"0,2\"],\n[\"_x\",\"3\"]]}\n");
    assert(s.names == "{\"p\":[\n[\"A, \\\"b\\\"\",\"learn/a\"],\n[\"B\",\"b\"]],\n\"h\":[\n[0,\"Sec\",\"sec\",0,\"\"],\n[1,\"push\",\"List.push\",0,\"method\"]]}\n", s.names);
    assert(s.excerpts.len() == 1 && s.excerpts[0] == "[\"lead, a\",\n\"\",\n\"x]y\",\n\"Add\"]\n", s.excerpts[0]);
    assert(s.text.len() == shards().len(), f"{s.text.len()} {shards().len()}");
    assert(s.text["k18"] == "{\"n\":4,\"w\":[\n]}\n", s.text["k18"]);
    assert(s.text["a"].contains("[\"apple\",\"1\"]") && s.text["k18"] == "{\"n\":4,\"w\":[\n]}\n", s.text["a"]);
    assert(s.text[shard_of("타입")].contains("타입") && s.text["0"].contains("_x") && shard_of("타입") == "k16", shard_of("타입"));
    let m = merge([("json/latest/", "{\"p\":[\n[\"json\",\"\",\"x\"],\n[\"json::read\",\"read\",\"y\"]],\n\"h\":[\n[1,\"parse\",\"parse\",0,\"fn\",\"z\"]]}\n"), ("csv/latest/", "{\"p\":[\n[\"csv\",\"\",\"x\"]],\n\"h\":[\n[0,\"Reader\",\"Reader\",0,\"struct\",\"\"]]}\n")]);
    assert(m.contains("[\"json\",\"json/latest\"]") && m.contains("[\"json::read\",\"json/latest/read\"]") && m.contains("[1,\"parse\"") && m.contains("[2,\"Reader\""), m);
}

#[test]
fn han_text() {
    let into: Set<str> = Set::new();
    words("函数的参数 list的方法 一", stop_words(), into);
    for w in ["函数", "数的", "的参", "参数", "数", "list", "的方", "方法", "法", "一"] { assert(into.contains(w), w); }
    assert(!into.contains("函数的参数") && !into.contains("list的方法") && !into.contains("函"), "no whole runs, a first character only in its pair");
    assert(shard_of("一个") == "h0" && shard_of("龥") == "h15" && shard_of("参数") == f"h{(0x53C2 - 0x4E00) / 0x520}" && shard_of("㐀") == "h15", shard_of("参数"));
    assert(shards().contains("h15") && !shards().contains("h16"), "shards");
}

#[test]
fn text_words() {
    let into: Set<str> = Set::new();
    words("The read_to_str function reads 42 files; 타입을 쓰면 x.", stop_words(), into);
    assert(into.contains("read_to_str") && into.contains("reads") && into.contains("files"), "latin words");
    assert(into.contains("타입") && !into.contains("the") && !into.contains("42") && !into.contains("x"), "bare and dropped");
    assert(b36(0) == "0" && b36(35) == "z" && b36(36) == "10", "base 36");
}
